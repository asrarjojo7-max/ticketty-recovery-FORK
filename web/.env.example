# Server-side URL used by the Next.js BFF route handlers.
# Must match the backend's configured PORT (see backend/.env).
API_BASE_URL=http://127.0.0.1:3001/api
APP_ORIGIN=http://localhost:3000
# Comma-separated extra browser origins the BFF accepts (e.g. when the dev
# server is exposed through a Cloudflare tunnel):
# APP_ORIGIN_ALT=https://app.suda-technologies.com
