[Unit]
Description=Ticketty accounting worker watchdog
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ticketty
Group=ticketty
WorkingDirectory=__TICKETTY_ROOT__
EnvironmentFile=/etc/ticketty/backup.env
Environment=METRICS_URL=http://127.0.0.1:3001/api/metrics
ExecStart=__TICKETTY_ROOT__/ops/worker-watchdog.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ticketty /var/log/ticketty
UMask=0077
