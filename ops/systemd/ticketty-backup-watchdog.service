[Unit]
Description=Ticketty independent backup freshness watchdog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ticketty
Group=ticketty
WorkingDirectory=__TICKETTY_ROOT__
EnvironmentFile=/etc/ticketty/backup.env
ExecStart=__TICKETTY_ROOT__/ops/backup-watchdog.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ticketty /var/log/ticketty
UMask=0077
