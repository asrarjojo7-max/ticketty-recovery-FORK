#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
INSTALL_ROOT="${TICKETTY_INSTALL_ROOT:-/srv/ticketty}"
ETC_ROOT="/etc/ticketty"
STATE_DIR="/var/lib/ticketty/deployment"
STATE_FILE="$STATE_DIR/state.env"
LOCK_FILE="/run/lock/ticketty-deploy.lock"
OPS_GROUP="ticketty-ops"
OPS_SOCKET="/run/ticketty/ops.sock"
OPS_HMAC_FILE="$ETC_ROOT/secrets/ticketty-ops-hmac"
TELEGRAM_TOKEN_FILE="$ETC_ROOT/secrets/telegram-bot-token"
TELEGRAM_ALERT_TOKEN_FILE="$ETC_ROOT/secrets/telegram-alert-webhook-token"
CLOUDFLARE_TOKEN_FILE="$ETC_ROOT/secrets/cloudflare-tunnel-token"
BACKUP_ROOT="${BACKUP_DIR:-/var/lib/ticketty/backups}"
DEFAULT_REPO="https://github.com/mogahedadamy/ticketty-recovery.git"
NON_INTERACTIVE=0; JSON_OUTPUT=0; CONFIRMED=0; DRY_RUN=0; REF=""
BACKEND_PORT=3001
WEB_PORT=3000
ok(){ printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn(){ printf '  \033[33m!\033[0m %s\n' "$*"; }
err(){ printf '  \033[31m✗\033[0m %s\n' "$*" >&2; }
die(){ err "$*"; exit 1; }
step(){ printf '\n\033[1m%s\033[0m\n' "$*"; }
root(){ [[ "$(id -u)" -eq 0 ]] || die "شغّل باستخدام sudo/root."; }
dirs(){ install -d -m 0700 "$STATE_DIR" "$STATE_DIR/logs" "$ETC_ROOT/secrets"; install -d -m 0750 /run/ticketty /run/lock; }
get(){ local key="$1"; [[ -f "$STATE_FILE" ]] || return 1; awk -F= -v k="$key" '$1==k{sub(/^[^=]*=/,"");print;exit}' "$STATE_FILE"; }
setv(){ local key="$1" val="$2" tmp; dirs; tmp="$(mktemp "$STATE_DIR/state.XXXXXX")"; [[ -f "$STATE_FILE" ]] && awk -F= -v k="$key" '$1!=k{print}' "$STATE_FILE" > "$tmp" || true; printf '%s=%s\n' "$key" "$val" >> "$tmp"; chmod 600 "$tmp"; mv "$tmp" "$STATE_FILE"; }
phase(){ local name="$1"; shift; [[ "$(get "PHASE_$name" 2>/dev/null || true)" == DONE ]] && { ok "$name — مكتمل سابقًا"; return; }; setv "PHASE_$name" RUNNING; if "$@"; then setv "PHASE_$name" DONE; setv "PHASE_${name}_AT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"; ok "$name"; else setv "PHASE_$name" FAILED; die "$name فشل. استخدم sudo ticketty resume."; fi; }
lock(){ dirs; exec 9>"$LOCK_FILE"; flock -n 9 || die "هناك عملية نشر أخرى تعمل."; }
load(){
  local v
  v="$(get PROJECT_DIR 2>/dev/null || true)"; [[ -n "$v" ]] && INSTALL_ROOT="$v"
  v="$(get REPOSITORY 2>/dev/null || true)"
  if [[ -n "$v" ]]; then REPOSITORY="$v"; else REPOSITORY="$DEFAULT_REPO"; fi
  if [[ -f "$ETC_ROOT/ticketty.env" ]]; then
    local p
    p="$(grep '^BACKEND_PORT=' "$ETC_ROOT/ticketty.env" | cut -d= -f2- || true)"
    [[ "$p" =~ ^[0-9]+$ ]] && BACKEND_PORT="$p"
    p="$(grep '^WEB_PORT=' "$ETC_ROOT/ticketty.env" | cut -d= -f2- || true)"
    [[ "$p" =~ ^[0-9]+$ ]] && WEB_PORT="$p"
  fi
}
packages(){ local miss=0 x; for x in git curl openssl jq flock docker; do command -v "$x" >/dev/null 2>&1 || miss=1; done; [[ "$miss" -eq 0 ]] && { systemctl enable --now docker >/dev/null 2>&1 || true; ok "المتطلبات موجودة"; return; }; . /etc/os-release; [[ "$ID" == ubuntu || "$ID" == debian || "$ID_LIKE" == *debian* ]] || die "التوزيعة غير مدعومة للتثبيت التلقائي."; if [[ "$NON_INTERACTIVE" -eq 0 ]]; then read -r -p "تثبيت المتطلبات تلقائيًا؟ [Y/n]: " a; [[ -z "$a" || "$a" =~ ^[Yy]$ ]] || die "تم الإلغاء."; fi; apt-get update; apt-get install -y ca-certificates git curl openssl jq util-linux docker.io docker-compose-v2; systemctl enable --now docker; }
resources(){ local ram free; ram="$(awk '/MemTotal:/ {print $2}' /proc/meminfo)"; free="$(df -Pk / | awk 'NR==2{print $4}')"; (( ram >= 2097152 )) || warn "RAM أقل من 2 GiB."; [[ "$free" -ge 20971520 ]] || die "المساحة الحرة أقل من 20 GiB."; ok "الموارد"; }
checkout(){ [[ -d "$INSTALL_ROOT/.git" ]] && { ok "المستودع موجود"; return; }; mkdir -p "$(dirname "$INSTALL_ROOT")"; git clone "$REPOSITORY" "$INSTALL_ROOT"; ok "تم جلب المستودع"; }
clean(){ git -C "$INSTALL_ROOT" diff --quiet || die "توجد تغييرات محلية غير محفوظة."; git -C "$INSTALL_ROOT" diff --cached --quiet || die "توجد تغييرات staged."; }
secret_file(){ local f="$1" n="$2"; [[ -s "$f" ]] || { openssl rand -base64 "$n" | tr -d '\n' > "$f"; chmod 600 "$f"; }; }
write_env(){ local f="$ETC_ROOT/ticketty.env"; [[ -f "$f" ]] && { ok "بيئة الإنتاج موجودة"; return; }; local db1 db2 db3 jwt pair ops; db1="$(openssl rand -hex 24)"; db2="$(openssl rand -hex 24)"; db3="$(openssl rand -hex 24)"; jwt="$(openssl rand -base64 48 | tr -d '\n')"; pair="$(openssl rand -hex 24)"; ops="$(openssl rand -hex 32)"; printf '%s\n' "$ops" > "$OPS_HMAC_FILE"; chmod 600 "$OPS_HMAC_FILE"; cat > "$f" <<EOF
POSTGRES_DB=ticketty
POSTGRES_USER=ticketty_admin
POSTGRES_PASSWORD=$db1
MIGRATION_DATABASE_URL=postgresql://ticketty_admin:$db1@postgres:5432/ticketty?schema=public
RUNTIME_DATABASE_PASSWORD=$db2
RUNTIME_DATABASE_URL=postgresql://ticketty_runtime:$db2@postgres:5432/ticketty?schema=public
MONITORING_DATABASE_PASSWORD=$db3
JWT_SECRET=$jwt
JWT_EXPIRES_IN=15m
JWT_ISSUER=ticketty-api
JWT_AUDIENCE=ticketty-web
WEB_ORIGIN=PLACEHOLDER
APP_ORIGIN=PLACEHOLDER
TRUST_PROXY_HOPS=1
ACCOUNTING_WORKER_ENABLED=true
ACCOUNTING_WORKER_INTERVAL_MS=5000
SUBSCRIPTION_SWEEP_ENABLED=true
SUBSCRIPTION_SWEEP_INTERVAL_MS=21600000
PILOT_PAYMENT_MODE=CASH
WEB_PORT=3000
BACKEND_PORT=3001
POSTGRES_EXPORTER_DSN=postgresql://ticketty_monitor:$db3@postgres:5432/ticketty?sslmode=disable
ALERTMANAGER_WEBHOOK_URL_FILE=$ETC_ROOT/alertmanager-webhook-url
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/ticketty/metrics
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
TELEGRAM_BOT_TOKEN_FILE=$TELEGRAM_TOKEN_FILE
TELEGRAM_PAIRING_CODE=$pair
TELEGRAM_ALERT_WEBHOOK_TOKEN_FILE=$TELEGRAM_ALERT_TOKEN_FILE
CLOUDFLARE_TUNNEL_TOKEN_FILE=$CLOUDFLARE_TOKEN_FILE
CLOUDFLARE_HOSTNAME=PLACEHOLDER
CLOUDFLARE_TUNNEL_IMAGE_TAG=2026.9.3
TICKETTY_GITHUB_REPOSITORY=mogahedadamy/ticketty-recovery
TICKETTY_RELEASE_CHANNEL=stable
TICKETTY_INSTALL_ROOT=$INSTALL_ROOT
TICKETTY_OPS_SOCKET=$OPS_SOCKET
TICKETTY_OPS_HMAC_FILE=$OPS_HMAC_FILE
TICKETTY_REMOTE_OPS_ENABLED=true
BACKUP_DIR=$BACKUP_ROOT
RCLONE_REMOTE=
RCLONE_WEEKLY_REMOTE=
RCLONE_MONTHLY_REMOTE=
BACKUP_RETENTION_DAYS=0
EOF
chmod 600 "$f"; printf '%s\n' "$pair" > "$STATE_DIR/pairing-code"; chmod 600 "$STATE_DIR/pairing-code"; ok "Environment + secrets"; }
domain(){ local d; d="$(get APP_HOSTNAME 2>/dev/null || true)"; [[ -n "$d" ]] && return; if [[ "$NON_INTERACTIVE" -eq 1 ]]; then d="${TICKETTY_DOMAIN:-}"; else read -r -p "الدومين (مثال app.example.com): " d; fi; [[ -n "$d" ]] || die "الدومين مطلوب."; sed -i "s#^WEB_ORIGIN=.*#WEB_ORIGIN=https://$d#;s#^APP_ORIGIN=.*#APP_ORIGIN=https://$d#;s#^CLOUDFLARE_HOSTNAME=.*#CLOUDFLARE_HOSTNAME=$d#" "$ETC_ROOT/ticketty.env"; setv APP_HOSTNAME "$d"; ok "الدومين $d"; }
telegram(){ if [[ ! -s "$TELEGRAM_TOKEN_FILE" ]]; then local t; if [[ "$NON_INTERACTIVE" -eq 1 ]]; then t="${TELEGRAM_BOT_TOKEN:-}"; else read -r -s -p "Telegram Bot Token من BotFather: " t; printf '\n'; fi; [[ -n "$t" ]] || die "Telegram Bot Token مطلوب."; printf '%s\n' "$t" > "$TELEGRAM_TOKEN_FILE"; chmod 600 "$TELEGRAM_TOKEN_FILE"; fi; secret_file "$TELEGRAM_ALERT_TOKEN_FILE" 32; getent group "$OPS_GROUP" >/dev/null 2>&1 || groupadd --system "$OPS_GROUP"; chown root:"$OPS_GROUP" "$OPS_HMAC_FILE"; chmod 640 "$OPS_HMAC_FILE"; ok "Telegram"; }
cloudflare(){ [[ -s "$CLOUDFLARE_TOKEN_FILE" ]] && { ok "Cloudflare Tunnel token موجود"; return; }; [[ "$NON_INTERACTIVE" -eq 1 ]] && return; printf '\nCloudflare\n  1) Tunnel موجود\n  2) إنشاء Tunnel + DNS تلقائيًا\n  3) لاحقًا\n'; local m t; read -r -p "اختر [1]: " m; [[ -n "$m" ]] || m=1; case "$m" in 1) read -r -s -p "Tunnel Token: " t; printf '\n'; [[ -n "$t" ]] || die "Tunnel Token مطلوب."; printf '%s\n' "$t" > "$CLOUDFLARE_TOKEN_FILE"; chmod 600 "$CLOUDFLARE_TOKEN_FILE";; 2) "$INSTALL_ROOT/ops/deployment/cloudflare.sh" wizard --env "$ETC_ROOT/ticketty.env" --token-file "$CLOUDFLARE_TOKEN_FILE";; 3) warn "Cloudflare مؤجل.";; *) die "خيار غير صالح.";; esac; }
compose_validate(){ docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" config >/dev/null; ok "Compose"; }
stack_up(){ docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" up -d --build; ok "الخدمات"; }
ops_service(){ getent group "$OPS_GROUP" >/dev/null 2>&1 || groupadd --system "$OPS_GROUP"; cp "$INSTALL_ROOT/ops/systemd/ticketty-ops.service" /etc/systemd/system/ticketty-ops.service; systemctl daemon-reload; systemctl enable --now ticketty-ops.service; systemctl is-active --quiet ticketty-ops.service || die "Remote Ops لم يبدأ."; ok "Remote Ops"; }
health(){ local bp="$BACKEND_PORT" wp="$WEB_PORT"; [[ -n "$bp" ]] || bp=3001; [[ -n "$wp" ]] || wp=3000; curl -fsS "http://127.0.0.1:$bp/api/health/liveness" >/dev/null && curl -fsS "http://127.0.0.1:$wp/api/health/live" >/dev/null; }
current_release(){ get RELEASE_REF 2>/dev/null || git -C "$INSTALL_ROOT" describe --tags --exact-match HEAD 2>/dev/null || git -C "$INSTALL_ROOT" rev-parse --short=12 HEAD; }
latest_json(){ local repo; repo="$(grep '^TICKETTY_GITHUB_REPOSITORY=' "$ETC_ROOT/ticketty.env" | cut -d= -f2-)"; curl -fsSL -H 'Accept: application/vnd.github+json' -H 'X-GitHub-Api-Version: 2022-11-28' "https://api.github.com/repos/$repo/releases/latest"; }
plan_json(){ local cur latest; cur="$(current_release)"; latest="$(latest_json | jq -r '.tag_name // empty')"; [[ -n "$latest" ]] || { jq -n --arg c "$cur" '{ok:true,update:false,current:$c,reason:"no-release"}'; return; }; if [[ "$cur" == "$latest" ]]; then jq -n --arg c "$cur" --arg l "$latest" '{ok:true,update:false,current:$c,latest:$l}'; else latest_json | jq --arg c "$cur" '{ok:true,update:true,current:$c,latest:.tag_name,url:.html_url,name:(.name//.tag_name),published_at:.published_at,body:(.body//"")}'; fi; }
prebackup(){ local db user stamp file; db="$(grep '^POSTGRES_DB=' "$ETC_ROOT/ticketty.env" | cut -d= -f2-)"; user="$(grep '^POSTGRES_USER=' "$ETC_ROOT/ticketty.env" | cut -d= -f2-)"; stamp="$(date -u +%Y%m%dT%H%M%SZ)"; file="$BACKUP_ROOT/pre-deploy/ticketty-$stamp.dump"; install -d -m 0700 "$BACKUP_ROOT/pre-deploy"; docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" exec -T postgres pg_dump -U "$user" -d "$db" --format=custom --no-owner --no-acl > "$file"; sha256sum "$file" > "$file.sha256"; setv LAST_PREDEPLOY_BACKUP "$file"; ok "Backup قبل التحديث"; }
update_ref(){ local target="$1" old; [[ "$target" =~ ^v?[0-9][A-Za-z0-9._+-]*$ ]] || die "Release tag غير صالح."; ensure_checkout; clean; [[ "$DRY_RUN" -eq 1 ]] && { ok "Dry run: $target"; return; }; prebackup; old="$(git -C "$INSTALL_ROOT" rev-parse HEAD)"; git -C "$INSTALL_ROOT" fetch --tags --force origin; git -C "$INSTALL_ROOT" rev-parse "refs/tags/$target" >/dev/null 2>&1 || die "Release غير موجود."; git -C "$INSTALL_ROOT" checkout --detach "$target"; if ! docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" up -d --build migrate; then git -C "$INSTALL_ROOT" checkout --detach "$old"; docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" up -d --build || true; die "فشل migration؛ لم يتم عكسه تلقائيًا."; fi; docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" up -d --build || { git -C "$INSTALL_ROOT" checkout --detach "$old"; docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" up -d --build || true; die "فشل تشغيل الإصدار الجديد."; }; health || { git -C "$INSTALL_ROOT" checkout --detach "$old"; docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" up -d --build || true; die "فشل health check."; }; setv RELEASE_REF "$target"; setv RELEASE_COMMIT "$(git -C "$INSTALL_ROOT" rev-parse HEAD)"; setv DEPLOYMENT_STATUS READY; setv LAST_UPDATE_AT "$(date -u +%Y-%m-%dT%H:%M:%SZ)"; ok "تم نشر $target"; }
cmd_install(){ root; lock; dirs; load; step "TICKETTY — التثبيت الذكي"; phase PREFLIGHT resources; phase PACKAGES packages; phase CHECKOUT checkout; setv PROJECT_DIR "$INSTALL_ROOT"; setv REPOSITORY "$REPOSITORY"; phase ENV write_env; ln -sfn "$ETC_ROOT/ticketty.env" "$INSTALL_ROOT/.env"; phase DOMAIN domain; phase TELEGRAM telegram; phase CLOUDFLARE cloudflare; phase COMPOSE compose_validate; phase DEPLOY stack_up; phase OPS ops_service; setv DEPLOYMENT_STATUS READY; step "اكتمل التثبيت"; }
cmd_resume(){ cmd_install; }
cmd_update(){ load; local p t; p="$(plan_json)"; if [[ "$JSON_OUTPUT" -eq 1 ]]; then printf '%s\n' "$p"; return; fi; [[ "$(printf '%s' "$p" | jq -r '.update // false')" == true ]] || { ok "لا يوجد Release أحدث."; return; }; t="$(printf '%s' "$p" | jq -r '.latest')"; if [[ "$CONFIRMED" -eq 0 ]]; then read -r -p "تحديث Ticketty إلى $t؟ [y/N]: " a; [[ "$a" =~ ^[Yy]$ ]] || die "تم الإلغاء."; fi; update_ref "$t"; }
status_json(){
  load
  local r d s o
  r="$(current_release)"
  d="$(get APP_HOSTNAME 2>/dev/null || true)"
  s="$(get DEPLOYMENT_STATUS 2>/dev/null || echo UNKNOWN)"
  o="$(systemctl is-active ticketty-ops.service 2>/dev/null || echo inactive)"
  jq -n --arg r "$r" --arg d "$d" --arg s "$s" --arg o "$o"     '{ok:true,release:$r,domain:$d,status:$s,remote_ops:$o}'
}
cmd_status(){
  load
  status_json
  [[ "$JSON_OUTPUT" -eq 1 ]] && return
  docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" ps || true
}
cmd_doctor(){ load; step "Ticketty — الفحص"; command -v docker >/dev/null && ok Docker || warn Docker; docker compose version >/dev/null 2>&1 && ok "Docker Compose" || warn "Docker Compose"; [[ -f "$INSTALL_ROOT/.env" ]] && ok Environment || warn Environment; [[ -s "$TELEGRAM_TOKEN_FILE" ]] && ok Telegram || warn Telegram; [[ -s "$CLOUDFLARE_TOKEN_FILE" ]] && ok Cloudflare || warn Cloudflare; [[ -s "$OPS_HMAC_FILE" ]] && ok "Ops secret" || warn "Ops secret"; systemctl is-active --quiet ticketty-ops.service && ok "Ops service" || warn "Ops service"; docker compose -f "$INSTALL_ROOT/compose.yaml" --env-file "$INSTALL_ROOT/.env" config >/dev/null && ok Compose || warn Compose; health && ok "Backend + Web" || warn "Backend/Web"; }
cmd_setup_cf(){ root; load; "$INSTALL_ROOT/ops/deployment/cloudflare.sh" wizard --env "$ETC_ROOT/ticketty.env" --token-file "$CLOUDFLARE_TOKEN_FILE"; }
usage(){ printf '%s\n' 'ticketty | install | resume | update | status | doctor | setup-cloudflare'; }
menu(){ while true; do step "TICKETTY DEPLOYMENT"; printf '  1) تثبيت النظام\n  2) متابعة التثبيت\n  3) تحديث النظام\n  4) الحالة\n  5) فحص النظام\n  6) Cloudflare\n  0) خروج\n\n'; read -r -p "اختر: " c; case "$c" in 1) cmd_install;;2) cmd_resume;;3) root;lock;cmd_update;;4) cmd_status;;5) cmd_doctor;;6) cmd_setup_cf;;0) return;;*) warn "اختيار غير صالح";; esac; done; }
main(){ local command=menu; while (($#)); do case "$1" in install|resume|update|status|doctor|setup-cloudflare) command="$1"; shift;; --non-interactive) NON_INTERACTIVE=1; shift;; --json) JSON_OUTPUT=1; shift;; --dry-run|--plan) DRY_RUN=1; shift;; --confirm) CONFIRMED=1; shift;; --ref) REF="$2"; shift 2;; -h|--help) usage; return;; *) die "وسيط غير معروف: $1";; esac; done; case "$command" in menu) menu;;install) cmd_install;;resume) cmd_resume;;update) [[ -n "$REF" ]] && { root;lock;update_ref "$REF"; } || { root;lock;cmd_update; };;status) cmd_status;;doctor) cmd_doctor;;setup-cloudflare) cmd_setup_cf;;esac; }
main "$@"
