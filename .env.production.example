# Copy to .env before using Docker Compose. Never commit the real file.
# The PostgreSQL bootstrap identity is for migrations/operations only.
POSTGRES_DB=ticketty
POSTGRES_USER=ticketty_admin
POSTGRES_PASSWORD=replace-with-a-strong-admin-database-password
MIGRATION_DATABASE_URL=postgresql://ticketty_admin:replace-with-url-encoded-admin-password@postgres:5432/ticketty?schema=public

# The API receives only this non-owner login credential. The migrate job creates
# or rotates this fixed ticketty_runtime role and grants only audited role memberships.
RUNTIME_DATABASE_PASSWORD=replace-with-a-separate-strong-runtime-password
RUNTIME_DATABASE_URL=postgresql://ticketty_runtime:replace-with-url-encoded-runtime-password@postgres:5432/ticketty?schema=public
MONITORING_DATABASE_PASSWORD=replace-with-a-separate-strong-monitor-password

JWT_SECRET=replace-with-output-from-openssl-rand-base64-48
JWT_EXPIRES_IN=15m
JWT_ISSUER=ticketty-api
JWT_AUDIENCE=ticketty-web
WEB_ORIGIN=https://ticketty.example.com
APP_ORIGIN=https://ticketty.example.com
# Client → Cloudflare → cloudflared → web/BFF → backend.
# The BFF replaces X-Forwarded-For with Cloudflare's verified client address.
TRUST_PROXY_HOPS=1
# Loopback for direct host deployment; Compose overrides this to 0.0.0.0 inside its private network.
API_BIND_HOST=127.0.0.1
ACCOUNTING_WORKER_ENABLED=true
ACCOUNTING_WORKER_INTERVAL_MS=5000
SUBSCRIPTION_SWEEP_ENABLED=true
SUBSCRIPTION_SWEEP_INTERVAL_MS=21600000
# Controlled pilot is intentionally cash-only. The backend rejects every
# non-CASH booking method independently of the UI.
PILOT_PAYMENT_MODE=CASH
WEB_PORT=3000
BACKEND_PORT=3001

# Private monitoring. Use a dedicated PostgreSQL monitoring login and keep the
# webhook URL in a root-readable 0600 file; never place it in this template.
POSTGRES_EXPORTER_DSN=postgresql://ticketty_monitor:replace-with-monitor-password@postgres:5432/ticketty?sslmode=disable
ALERTMANAGER_WEBHOOK_URL_FILE=/etc/ticketty/alertmanager-webhook-url
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/ticketty/metrics
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Telegram Operations Assistant. Secrets must be generated outside Git.
TELEGRAM_BOT_TOKEN=replace-with-BotFather-token
TELEGRAM_BOT_TOKEN_FILE=/etc/ticketty/secrets/telegram-bot-token
TELEGRAM_PAIRING_CODE=replace-with-one-time-pairing-code
TELEGRAM_ALERT_WEBHOOK_TOKEN_FILE=/etc/ticketty/secrets/telegram-alert-webhook-token
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_REQUEST_TIMEOUT_MS=15000

# Remote Operations control plane. The installer writes this GID after creating
# the dedicated host group; Telegram gets only this group access to the Unix socket.
TICKETTY_OPS_GID=replace-with-host-group-gid
TICKETTY_OPS_SOCKET=/run/ticketty/ops.sock
TICKETTY_OPS_HMAC_FILE=/etc/ticketty/secrets/ticketty-ops-hmac
TICKETTY_REMOTE_OPS_ENABLED=true

# Cloudflare Tunnel is enabled by the installer when a tunnel token is present.
CLOUDFLARE_TUNNEL_TOKEN_FILE=/etc/ticketty/secrets/cloudflare-tunnel-token
CLOUDFLARE_HOSTNAME=app.ticketty.example
CLOUDFLARE_TUNNEL_IMAGE_TAG=2026.9.3


# Backup scheduler (stored outside application containers).
RCLONE_REMOTE=gdrive:Ticketty Production/01_Database_Backups/Daily
RCLONE_WEEKLY_REMOTE=gdrive:Ticketty Production/01_Database_Backups/Weekly
RCLONE_MONTHLY_REMOTE=gdrive:Ticketty Production/01_Database_Backups/Monthly
BACKUP_DIR=/var/lib/ticketty/backups
BACKUP_STATE_DIR=/var/lib/ticketty/backup-state
BACKUP_METRICS_DIR=/var/lib/ticketty/metrics
# Zero means no deletion. Set only after retention is formally approved.
BACKUP_RETENTION_DAYS=0
