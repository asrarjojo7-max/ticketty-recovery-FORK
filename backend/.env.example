DATABASE_URL=postgresql://ticketty:ticketty@127.0.0.1:55432/ticketty?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=ticketty-api
JWT_AUDIENCE=ticketty-web
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Number of trusted reverse proxies in front of the API. Keep 0 for direct/local use.
TRUST_PROXY_HOPS=0
# Enable exactly in processes intended to run the leased accounting worker.
ACCOUNTING_WORKER_ENABLED=false
ACCOUNTING_WORKER_INTERVAL_MS=5000

# Required only when running pnpm db:seed
INITIAL_ORG_NAME=شركة النقل التجريبية
INITIAL_ORG_SLUG=demo-transport
INITIAL_ADMIN_NAME=مدير النظام
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
